# Release images. Never deploy the floating "latest" tag.
SCHOLAR_VERSION=3.0.0
SCHOLAR_COMPOSE_PROJECT_NAME=scholar
SCHOLAR_API_IMAGE=ghcr.io/airalogy/scholar-api:3.0.0
SCHOLAR_WEB_IMAGE=ghcr.io/airalogy/scholar-web:3.0.0
POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:7ae6051efd0e60444282c27c7e141af07f322ce033300e727a49c3dd11075e38
# The formal Release package rewrites this to true and includes generated manifests.
# Keep false only for source-based local validation, never for school production.
SCHOLAR_RELEASE_METADATA_REQUIRED=false
SCHOLAR_OFFLINE=false

# Optional Docker IPv4 network. Leave blank to use Docker's automatic address
# allocation. Institution deployments should choose a subnet that does not
# overlap campus, VPN, host-route, or existing Docker networks.
SCHOLAR_DOCKER_SUBNET=
# Optional; Docker selects a gateway automatically when this is blank.
SCHOLAR_DOCKER_GATEWAY=
# Comma-separated IPv4 CIDRs that Scholar's Docker network must avoid.
SCHOLAR_RESERVED_SUBNETS=

# Only used when building from source. These can also point to ACR/TCR/Harbor.
SCHOLAR_NODE_BUILD_IMAGE=node:22.23.0-bookworm-slim@sha256:d9f850096136edbc402debdd8729579a288aac64574ada0ff4db26b6ae58b0b2
SCHOLAR_CADDY_BUILD_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

# Use "bundled" for the included PostgreSQL container, or "external" for a
# PostgreSQL/pgvector service managed by the deploying institution.
SCHOLAR_DATABASE_MODE=bundled
POSTGRES_USER=scholar
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=scholar
DATABASE_URL=postgresql://scholar:replace-with-a-long-random-database-password@postgres:5432/scholar?schema=public

# Persistent storage. Named volumes are the safe zero-configuration default.
# To use visible host directories, set absolute paths such as:
# SCHOLAR_POSTGRES_STORAGE=/srv/scholar-data/postgres
# SCHOLAR_UPLOADS_STORAGE=/srv/scholar-data/uploads
# SCHOLAR_BACKUP_DIR=/srv/scholar-data/backups
# SCHOLAR_STATE_DIR=/srv/scholar-data/state
SCHOLAR_POSTGRES_STORAGE=scholar_postgres
SCHOLAR_UPLOADS_STORAGE=scholar_uploads
SCHOLAR_POSTGRES_VOLUME_NAME=scholar_postgres
SCHOLAR_UPLOADS_VOLUME_NAME=scholar_uploads
SCHOLAR_BRANDING_STORAGE=./branding
SCHOLAR_BACKUP_DIR=./backups
SCHOLAR_STATE_DIR=./state
# Set when exporting offline images; use linux/amd64 for common x86 school servers.
SCHOLAR_TARGET_PLATFORM=linux/amd64

# Bind only to the local reverse proxy by default. Set 0.0.0.0 only when the
# container itself is the intended network entry point.
SCHOLAR_HTTP_BIND=127.0.0.1
SCHOLAR_HTTP_PORT=8080

NODE_ENV=production
LOG_LEVEL=info
DEPLOYMENT_MODE=private
PRIVATE_INSTITUTION_SLUG=replace-with-institution-slug
JWT_SECRET=replace-with-at-least-32-random-characters

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/var/lib/scholar/uploads

ENABLE_PASSWORD_SIGNIN=true
ENABLE_PUBLIC_SIGNUP=false
ENABLE_AIRALOGY_OAUTH=false
ENABLE_INSTITUTION_LOGIN=false
# Empty uses PRIVATE_INSTITUTION_SLUG in private deployments.
INSTITUTION_LOGIN_INSTITUTION_SLUG=
ENABLE_INSTITUTION_PROVISION_LOGIN=false
INSTITUTION_SSO_ENABLED=false

# Scholar's product deployment includes AI chat and the paper-reading assistant.
# Set the OpenAI-compatible endpoint and key below before running preflight.
ENABLE_AI_CHAT=true
SCHOLAR_TIMELINE_GENERATION_MODE=disabled
TIMELINE_CONCURRENCY=2
TIMELINE_DAILY_USER_LIMIT=3
ENABLE_PAPER_UPLOAD=true
ENABLE_DEGREE_THESES=true
ENABLE_FORUM=false

PUBLIC_APP_NAME=Institution Scholar
SHOW_BRAND_LOGO=false
SHOW_INSTITUTION_LOGO=false
PUBLIC_BRAND_LOGO_URL=
PUBLIC_INSTITUTION_LOGO_URL=
PUBLIC_INSTITUTION_WATERMARK_URL=

# Required while ENABLE_AI_CHAT=true. Keep real credentials only in deploy/.env.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-v4
CHAT_MODEL=qwen3.5-plus
TIMELINE_MODEL=
OPENALEX_MAILTO=

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

AIRALOGY_OAUTH_BASE_URL=
AIRALOGY_OAUTH_CLIENT_ID=
AIRALOGY_OAUTH_CLIENT_SECRET=
AIRALOGY_OAUTH_REDIRECT_URI=
AIRALOGY_OAUTH_SCOPE=basic

# Institution SSO. Required when INSTITUTION_SSO_ENABLED=true.
INSTITUTION_SSO_TYPE=oauth2
INSTITUTION_SSO_PROVIDER_ID=institution-sso
INSTITUTION_SSO_DISPLAY_NAME=Institution Single Sign-On
INSTITUTION_SSO_AUTHORIZATION_URL=
INSTITUTION_SSO_TOKEN_URL=
INSTITUTION_SSO_USERINFO_URL=
INSTITUTION_SSO_CLIENT_ID=
INSTITUTION_SSO_CLIENT_SECRET=
INSTITUTION_SSO_REDIRECT_URI=https://scholar.example.edu/institution_sso_callback
INSTITUTION_SSO_SCOPE=basic
INSTITUTION_SSO_EXTERNAL_ID_FIELD=sub
INSTITUTION_SSO_EMAIL_FIELD=email
INSTITUTION_SSO_NAME_FIELD=name
INSTITUTION_SSO_USERINFO_TOKEN_MODE=bearer

#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Scholar pre-push: pnpm is required. Run corepack enable and pnpm install." >&2
  exit 1
fi

echo "Scholar pre-push: checking the complete pending push scope..."
# Preserve Git's ref list on stdin; pnpm can consume stdin itself.
node scripts/run-checks.mjs --pre-push

{
  "name": "airalogy-scholar",
  "version": "3.0.0",
  "private": true,
  "description": "Airalogy Scholar - Vue 3 + Vite + Arco Design + Fastify",
  "bugs": {
    "url": "https://github.com/airalogy/scholar/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/airalogy/scholar.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --parallel run build",
    "preview": "pnpm -r --parallel run preview",
    "lint": "pnpm -r --parallel run lint",
    "type-check": "pnpm -r --parallel run type-check",
    "test": "pnpm -r run test && pnpm test:deployment",
    "test:deployment": "node --test scripts/*.test.mjs",
    "check": "pnpm ci:config:check && pnpm version:check && pnpm release:source:check && pnpm db:validate && pnpm db:generate && pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm --filter @airalogy/scholar-server smoke:dist",
    "ci:config:check": "node scripts/check-ci-config.mjs",
    "prepush": "pnpm check",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "license:check": "node scripts/check-licenses.mjs",
    "format:check": "pnpm --filter @airalogy/scholar-server run fmt:check",
    "version:check": "node scripts/check-version.mjs",
    "release:source:check": "node scripts/create-release-source-snapshot.mjs --check",
    "release:source:verify": "node scripts/create-release-source-snapshot.mjs --verify",
    "release:check": "node scripts/check-release.mjs",
    "db:push": "pnpm --filter @airalogy/scholar-server db:push",
    "db:migrate": "pnpm --filter @airalogy/scholar-server db:migrate",
    "db:migrate:deploy": "pnpm --filter @airalogy/scholar-server db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @airalogy/scholar-server db:migrate:status",
    "db:generate": "node scripts/run-prisma-command.mjs db:generate",
    "db:validate": "node scripts/run-prisma-command.mjs db:validate",
    "db:audit:integrity": "pnpm --filter @airalogy/scholar-server db:audit:integrity",
    "db:studio": "pnpm --filter @airalogy/scholar-server db:studio",
    "db:seed": "pnpm --filter @airalogy/scholar-server db:seed",
    "bootstrap:deployment": "pnpm --filter @airalogy/scholar-server bootstrap:deployment",
    "import:scholar-timeline": "pnpm --filter @airalogy/scholar-server import:scholar-timeline",
    "enqueue:scholar-timelines": "pnpm --filter @airalogy/scholar-server enqueue:scholar-timelines"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "^1.1.18",
      "brace-expansion@^2.0.0": "^2.1.4",
      "brace-expansion@^5.0.0": "^5.0.9",
      "fast-uri@^3.0.0": "^3.1.5",
      "flatted@^3.0.0": "^3.4.2",
      "immutable@^5.0.0": "^5.1.8",
      "lodash@^4.0.0": "^4.18.0",
      "nanoid@^3.0.0": "^3.3.18",
      "picomatch@^4.0.0": "^4.0.4",
      "postcss@^8.0.0": "^8.5.23",
      "qs@^6.0.0": "^6.15.2",
      "svgo@^3.0.0": "^3.3.4",
      "ws@^8.0.0": "^8.21.0",
      "yaml@^2.0.0": "^2.8.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, vector]
}

model users {
  id                             String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String                                  @db.VarChar(100)
  email                          String                                  @unique(map: "users_email_idx") @db.VarChar(100)
  password_hash                  String?                                 @db.VarChar
  username                       String                                  @unique(map: "users_username_idx") @db.VarChar(64)
  phone                          String?                                 @db.VarChar(11)
  avatar                         String?                                 @db.VarChar
  bio                            String?                                 @db.VarChar
  createdAt                      DateTime                                @default(now()) @db.Timestamp(6)
  updatedAt                      DateTime                                @default(now()) @db.Timestamp(6)
  airalogy_user_id               String?                                 @unique(map: "users_airalogy_user_id_idx", where: raw("(airalogy_user_id IS NOT NULL)")) @db.Uuid
  gender                         String?                                 @db.VarChar(16)
  grade                          String?                                 @db.VarChar(32)
  degree                         String?                                 @db.VarChar(32)
  college                        String?                                 @db.VarChar(100)
  major                          String?                                 @db.VarChar(100)
  laboratory                     String?                                 @db.VarChar(200)
  research_interests             String?                                 @db.VarChar
  project_experiences            Json?
  publications                   Json?
  platform_role                  String                                  @default("member") @db.VarChar(16)
  requested_timeline_generations scholar_research_timeline_generations[] @relation("TimelineGenerationRequestedBy")
  reviewed_timeline_generations  scholar_research_timeline_generations[] @relation("TimelineGenerationReviewedBy")
  scholar_timeline_requests      scholar_research_timeline_requests[]
  institution_memberships        institution_memberships[]
  lab_memberships                lab_memberships[]
  paper_submissions              paper_submissions[]
  submitted_paper_claims         paper_claims[]                          @relation("PaperClaimSubmittedBy")
  bookmarks                      user_bookmarks[]
  forum_posts                    forum_posts[]
  forum_comments                 forum_comments[]
  forum_likes                    forum_likes[]
  import_requests                institution_data_imports[]              @relation("ImportActorUser")
  reviewed_imports               institution_data_imports[]              @relation("ImportReviewedBy")
  join_requests                  institution_join_requests[]             @relation("JoinRequestUser")
  reviewed_join_requests         institution_join_requests[]             @relation("JoinRequestReviewedBy")
  paper_author_bindings          institution_paper_author_bindings[]     @relation("PaperAuthorBindingUser")
  created_paper_author_bindings  institution_paper_author_bindings[]     @relation("PaperAuthorBindingCreatedBy")
  file_access_audits             file_access_audits[]
  chats                          chats[]
  submitted_feedbacks            feedbacks[]                             @relation("FeedbackSubmittedBy")
  handled_feedbacks              feedbacks[]                             @relation("FeedbackHandledBy")
  uploaded_files                 oss_files[]
  created_institution_provisions institution_user_provisions[]           @relation("ProvisionCreatedBy")
  claimed_institution_provisions institution_user_provisions[]           @relation("ProvisionClaimedBy")
  external_identities            user_external_identities[]
  created_api_credentials        institution_api_credentials[]
  created_org_nodes              institution_org_nodes[]
  linked_org_people              institution_org_people[]
  created_review_workflows       institution_review_workflows[]
  submitted_content_reviews      content_review_cases[]                  @relation("ContentReviewSubmittedBy")
  decided_content_reviews        content_review_cases[]                  @relation("ContentReviewDecidedBy")
  content_review_actions         content_review_actions[]
  submitted_degree_theses        degree_theses[]                         @relation("DegreeThesisSubmittedBy")
  created_degree_thesis_versions degree_thesis_versions[]                @relation("DegreeThesisVersionCreatedBy")
}

model user_external_identities {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  provider   String   @db.VarChar(100)
  externalId String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @db.Timestamp(6)
  user       users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_external_identities_userId_fkey")

  @@unique([provider, externalId], map: "user_external_identities_provider_externalId_idx")
  @@unique([userId, provider], map: "user_external_identities_userId_provider_idx")
  @@index([userId])
}

model authors {
  id                         String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                              @db.VarChar(100)
  email                      String?                             @db.VarChar(100)
  phone                      String?                             @db.VarChar(100)
  createdAt                  DateTime                            @db.Timestamp(6)
  updatedAt                  DateTime                            @db.Timestamp(6)
  paper_links                paper_authors[]
  institution_paper_bindings institution_paper_author_bindings[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model embeddings {
  id           Int                     @id @default(autoincrement())
  paperId      String                  @db.Uuid
  segmentIndex Int                     @db.SmallInt
  text         String                  @db.VarChar
  embedding    Unsupported("vector")?
  createdAt    DateTime                @db.Timestamp(6)
  tsv          Unsupported("tsvector")
  paper        papers                  @relation(fields: [paperId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "embeddings_paperId_fkey")

  @@unique([paperId, segmentIndex], map: "embeddings_paperId_segmentIndex_idx")
  @@index([embedding], map: "idx_embeddings_hnsw_cosine")
}

model oss_files {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  original_name          String                   @db.VarChar(255)
  file_size              Int
  mime_type              String                   @db.VarChar
  hash                   String                   @db.VarChar
  ext                    String                   @default("") @db.VarChar
  userId                 String?                  @db.Uuid
  createdAt              DateTime                 @db.Timestamp(6)
  prefix                 String                   @default("") @db.VarChar(100)
  institutionId          String?                  @db.Uuid
  security_profile       String                   @default("standard") @db.VarChar(32)
  watermark_enabled      Boolean                  @default(false)
  submissions            paper_submissions[]
  access_audits          file_access_audits[]
  degree_thesis_versions degree_thesis_versions[]
  user                   users?                   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "oss_files_userId_fkey")
  institution            institutions?            @relation(fields: [institutionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "oss_files_institutionId_fkey")

  @@index([userId])
  @@index([institutionId])
  @@index([security_profile])
}

model file_access_audits {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ossFileId     String        @db.Uuid
  userId        String        @db.Uuid
  paperId       String?       @db.Uuid
  institutionId String?       @db.Uuid
  access_type   String        @db.VarChar(16)
  watermarked   Boolean       @default(false)
  request_id    String?       @db.VarChar(64)
  ip_address    String?       @db.VarChar(128)
  user_agent    String?       @db.VarChar(1000)
  createdAt     DateTime      @default(now()) @db.Timestamp(6)
  file          oss_files     @relation(fields: [ossFileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "file_access_audits_ossFileId_fkey")
  user          users         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "file_access_audits_userId_fkey")
  paper         papers?       @relation(fields: [paperId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "file_access_audits_paperId_fkey")
  institution   institutions? @relation(fields: [institutionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "file_access_audits_institutionId_fkey")

  @@index([ossFileId, createdAt])
  @@index([userId, createdAt])
  @@index([institutionId, createdAt])
  @@index([access_type, createdAt])
}

model paper_authors {
  id       Int     @id @default(autoincrement())
  paperId  String  @db.Uuid
  authorId String  @db.Uuid
  order    Int     @db.SmallInt
  paper    papers  @relation(fields: [paperId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "paper_authors_paperId_fkey")
  author   authors @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "paper_authors_authorId_fkey")

  @@unique([paperId, authorId], map: "paper_authors_paperId_authorId_idx")
  @@index([authorId])
}

model papers {
  id                              String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                           String                              @db.VarChar(500)
  abstract                        String?                             @db.VarChar
  doi                             String                              @db.VarChar(100)
  normalized_doi                  String                              @unique(map: "papers_normalized_doi_key") @db.VarChar(100)
  journal_name                    String?                             @db.VarChar(100)
  publish_year                    Int?                                @db.SmallInt
  publish_date                    DateTime?                           @db.Date
  publication_metadata_source     String?                             @db.VarChar(32)
  publication_metadata_checked    DateTime?                           @db.Timestamp(6)
  paper_type                      Int?                                @db.SmallInt
  language                        Int?                                @db.SmallInt
  citation_count                  Int?
  pages                           String?                             @db.VarChar(50)
  keywords                        String[]                            @default([]) @db.VarChar
  createdAt                       DateTime                            @db.Timestamp(6)
  updatedAt                       DateTime                            @db.Timestamp(6)
  link                            String?                             @db.VarChar(255)
  research_timeline_period_papers scholar_research_period_papers[]
  research_timeline_issues        scholar_research_timeline_issues[]
  embeddings                      embeddings[]
  author_links                    paper_authors[]
  scholar_links                   scholar_papers[]
  bookmarks                       user_bookmarks[]
  claims                          paper_claims[]
  submissions                     paper_submissions[]
  forum_posts                     forum_posts[]
  file_access_audits              file_access_audits[]
  institution_author_bindings     institution_paper_author_bindings[]

  @@index([doi])
}

model chats {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  mode      String   @default("general") @db.VarChar(32)
  messages  Json?
  createdAt DateTime @db.Timestamp(6)
  updatedAt DateTime @db.Timestamp(6)
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chats_userId_fkey")

  @@index([userId, mode, updatedAt(sort: Desc)], map: "chats_userId_mode_updatedAt_idx")
}

model user_bookmarks {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  paperId   String   @db.Uuid
  createdAt DateTime @db.Timestamp(6)
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_bookmarks_userId_fkey")
  paper     papers   @relation(fields: [paperId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_bookmarks_paperId_fkey")

  @@unique([userId, paperId])
  @@index([paperId])
}

model feedbacks {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @db.Uuid
  email     String?   @db.VarChar(100)
  title     String    @db.VarChar(200)
  type      String    @db.VarChar(32)
  content   String    @db.VarChar
  status    String    @default("pending") @db.VarChar(32)
  handledBy String?   @db.Uuid
  handledAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
  user      users?    @relation("FeedbackSubmittedBy", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "feedbacks_userId_fkey")
  handler   users?    @relation("FeedbackHandledBy", fields: [handledBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "feedbacks_handledBy_fkey")

  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([handledBy])
  @@index([createdAt])
}

model scholars {
  id                            String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                                  @db.VarChar(100)
  avatar                        String?                                 @db.VarChar
  title                         String?                                 @db.VarChar(50)
  lab                           String?                                 @db.VarChar(200)
  office                        String?                                 @db.VarChar(100)
  email                         String?                                 @db.VarChar(100)
  phone                         String?                                 @db.VarChar(20)
  bio                           String?                                 @db.VarChar
  join_year                     Int?
  research_directions           Json?
  education                     Json?
  achievements                  Json?
  letter_index                  String?                                 @db.VarChar(1)
  createdAt                     DateTime                                @db.Timestamp(6)
  updatedAt                     DateTime                                @db.Timestamp(6)
  college                       String[]                                @default([]) @db.VarChar
  research_timeline_generations scholar_research_timeline_generations[]
  research_timeline_periods     scholar_research_periods[]
  paper_links                   scholar_papers[]
  institution_mappings          institution_scholar_mappings[]
  subject_links                 scholar_subjects[]
}

model academic_subjects {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                         @unique(map: "academic_subjects_code_idx") @db.VarChar(100)
  parentId             String?                        @db.Uuid
  institutionId        String?                        @db.Uuid
  nameZh               String                         @db.VarChar(200)
  nameEn               String?                        @db.VarChar(200)
  source               String                         @default("platform") @db.VarChar(64)
  taxonomyVersion      String?                        @db.VarChar(64)
  isActive             Boolean                        @default(true)
  sortOrder            Int                            @default(0)
  createdAt            DateTime                       @default(now()) @db.Timestamp(6)
  updatedAt            DateTime                       @default(now()) @db.Timestamp(6)
  parent               academic_subjects?             @relation("AcademicSubjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "academic_subjects_parentId_fkey")
  children             academic_subjects[]            @relation("AcademicSubjectHierarchy")
  institution          institutions?                  @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "academic_subjects_institutionId_fkey")
  aliases              academic_subject_aliases[]
  scholar_links        scholar_subjects[]
  institution_mappings institution_subject_mappings[]

  @@index([parentId])
  @@index([institutionId, isActive, sortOrder], map: "academic_subjects_institution_active_order_idx")
  @@index([isActive, sortOrder], map: "academic_subjects_active_order_idx")
}

model academic_subject_aliases {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId       String            @db.Uuid
  scopeKey        String            @default("global") @db.VarChar(64)
  alias           String            @db.VarChar(200)
  normalizedAlias String            @db.VarChar(200)
  locale          String?           @db.VarChar(16)
  createdAt       DateTime          @default(now()) @db.Timestamp(6)
  subject         academic_subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "academic_subject_aliases_subjectId_fkey")

  @@unique([scopeKey, normalizedAlias], map: "academic_subject_aliases_scope_normalized_idx")
  @@index([subjectId])
}

model scholar_subjects {
  scholarId    String            @db.Uuid
  subjectId    String            @db.Uuid
  isPrimary    Boolean           @default(false)
  displayOrder Int               @default(0)
  source       String            @default("manual") @db.VarChar(64)
  createdAt    DateTime          @default(now()) @db.Timestamp(6)
  scholar      scholars          @relation(fields: [scholarId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_subjects_scholarId_fkey")
  subject      academic_subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_subjects_subjectId_fkey")

  @@id([scholarId, subjectId])
  @@index([subjectId, scholarId], map: "scholar_subjects_subjectId_scholarId_idx")
}

model institution_subject_mappings {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId       String            @db.Uuid
  subjectId           String            @db.Uuid
  localCode           String?           @db.VarChar(100)
  normalizedLocalCode String?           @db.VarChar(100)
  localName           String            @db.VarChar(200)
  normalizedLocalName String            @db.VarChar(200)
  createdAt           DateTime          @default(now()) @db.Timestamp(6)
  updatedAt           DateTime          @default(now()) @db.Timestamp(6)
  institution         institutions      @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "institution_subject_mappings_institutionId_fkey")
  subject             academic_subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "institution_subject_mappings_subjectId_fkey")

  @@unique([institutionId, normalizedLocalName], map: "institution_subject_mappings_inst_name_idx")
  @@unique([institutionId, normalizedLocalCode], map: "institution_subject_mappings_inst_code_idx")
  @@index([subjectId])
}

model scholar_papers {
  id                Int      @id @default(autoincrement())
  scholarId         String   @db.Uuid
  paperId           String   @db.Uuid
  is_representative Boolean  @default(false)
  display_order     Int?
  scholar           scholars @relation(fields: [scholarId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_papers_scholarId_fkey")
  paper             papers   @relation(fields: [paperId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_papers_paperId_fkey")

  @@unique([scholarId, paperId])
}

model labs {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String              @db.VarChar(200)
  slug          String              @unique(map: "labs_slug_idx") @db.VarChar(200)
  summary       String?             @db.VarChar
  college       String?             @db.VarChar(100)
  location      String?             @db.VarChar(100)
  website       String?             @db.VarChar(255)
  createdAt     DateTime            @default(now()) @db.Timestamp(6)
  updatedAt     DateTime            @default(now()) @db.Timestamp(6)
  institutionId String?             @db.Uuid
  institution   institutions?       @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "labs_institutionId_fkey")
  memberships   lab_memberships[]
  claims        paper_claims[]
  submissions   paper_submissions[]

  @@index([institutionId])
}

model lab_memberships {
  id        Int      @id @default(autoincrement())
  labId     String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("member") @db.VarChar(16)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  lab       labs     @relation(fields: [labId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lab_memberships_labId_fkey")
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lab_memberships_userId_fkey")

  @@unique([labId, userId], map: "lab_memberships_labId_userId_idx")
  @@index([userId])
}

model institutions {
  id                     String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                                 @db.VarChar(200)
  slug                   String                                 @unique(map: "institutions_slug_idx") @db.VarChar(200)
  summary                String?                                @db.VarChar
  website                String?                                @db.VarChar(255)
  createdAt              DateTime                               @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                               @default(now()) @db.Timestamp(6)
  labs                   labs[]
  memberships            institution_memberships[]
  scholar_mappings       institution_scholar_mappings[]
  imports                institution_data_imports[]
  join_requests          institution_join_requests[]
  paper_author_bindings  institution_paper_author_bindings[]
  paper_claims           paper_claims[]
  paper_submissions      paper_submissions[]
  file_access_audits     file_access_audits[]
  api_credentials        institution_api_credentials[]
  user_provisions        institution_user_provisions[]
  stored_files           oss_files[]
  org_nodes              institution_org_nodes[]
  org_edges              institution_org_edges[]
  org_people             institution_org_people[]
  org_positions          institution_org_positions[]
  org_appointments       institution_org_appointments[]
  review_workflows       institution_review_workflows[]
  review_bindings        institution_review_workflow_bindings[]
  review_workflow_steps  institution_review_workflow_steps[]
  content_review_cases   content_review_cases[]
  content_review_steps   content_review_step_instances[]
  content_review_actions content_review_actions[]
  degree_theses          degree_theses[]
  academic_subjects      academic_subjects[]
  subject_mappings       institution_subject_mappings[]
}

model institution_memberships {
  id                 Int          @id @default(autoincrement())
  institutionId      String       @db.Uuid
  userId             String       @db.Uuid
  role               String       @default("member") @db.VarChar(16)
  createdAt          DateTime     @default(now()) @db.Timestamp(6)
  updatedAt          DateTime     @default(now()) @db.Timestamp(6)
  can_review_content Boolean      @default(false)
  can_import_data    Boolean      @default(false)
  institution        institutions @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "institution_memberships_institutionId_fkey")
  user               users        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "institution_memberships_userId_fkey")

  @@unique([institutionId, userId], map: "institution_memberships_institutionId_userId_idx")
  @@index([userId])
}

model institution_user_provisions {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId      String                   @db.Uuid
  createdBy          String                   @db.Uuid
  claimedUserId      String?                  @db.Uuid
  email              String                   @db.VarChar(100)
  name               String                   @db.VarChar(100)
  role               String                   @default("member") @db.VarChar(16)
  externalId         String?                  @db.VarChar(64)
  college            String?                  @db.VarChar(100)
  major              String?                  @db.VarChar(100)
  laboratory         String?                  @db.VarChar(200)
  inviteToken        String                   @unique(map: "institution_user_provisions_inviteToken_idx") @db.VarChar(128)
  status             String                   @default("pending_activation") @db.VarChar(32)
  claimedAt          DateTime?                @db.Timestamp(6)
  expiresAt          DateTime?                @db.Timestamp(6)
  createdAt          DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt          DateTime                 @default(now()) @db.Timestamp(6)
  can_review_content Boolean                  @default(false)
  can_import_data    Boolean                  @default(false)
  institution        institutions             @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "institution_user_provisions_institutionId_fkey")
  created_by         users                    @relation("ProvisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "institution_user_provisions_createdBy_fkey")
  claimed_user       users?                   @relation("ProvisionClaimedBy", fields: [claimedUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "institution_user_provisions_claimedUserId_fkey")
  org_people         institution_org_people[]

  @@unique([institutionId, email], map: "institution_user_provisions_institutionId_email_idx")
  @@index([status])
  @@index([claimedUserId])
  @@index([createdBy])
}

model institution_api_credentials {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String                     @db.Uuid
  name          String                     @db.VarChar(100)
  clientId      String                     @unique(map: "institution_api_credentials_clientId_idx") @db.VarChar(64)
  secretHash    String                     @db.VarChar
  scopes        String[]                   @default([]) @db.VarChar
  expiresAt     DateTime                   @db.Timestamp(6)
  revokedAt     DateTime?                  @db.Timestamp(6)
  secretVersion Int                        @default(1)
  lastUsedAt    DateTime?                  @db.Timestamp(6)
  lastUsedIp    String?                    @db.VarChar(128)
  createdBy     String                     @db.Uuid
  createdAt     DateTime                   @default(now()) @db.Timestamp(6)
  updatedAt     DateTime                   @default(now()) @db.Timestamp(6)

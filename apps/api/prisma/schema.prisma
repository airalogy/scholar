  actor         users                          @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "content_review_actions_actorId_fkey")

  @@index([caseId, createdAt], map: "content_review_actions_case_created_idx")
  @@index([institutionId, createdAt], map: "content_review_actions_inst_created_idx")
  @@index([actorId, createdAt], map: "content_review_actions_actor_created_idx")
}

model degree_theses {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId         String                   @db.Uuid
  record_code           String                   @unique(map: "degree_theses_record_code_idx") @db.VarChar(64)
  institution_reference String?                  @db.VarChar(100)
  submittedBy           String                   @db.Uuid
  reviewCaseId          String                   @unique(map: "degree_theses_reviewCaseId_idx") @db.Uuid
  currentVersionId      String?                  @unique(map: "degree_theses_currentVersionId_idx") @db.Uuid
  publishedVersionId    String?                  @unique(map: "degree_theses_publishedVersionId_idx") @db.Uuid
  publishedAt           DateTime?                @db.Timestamp(6)
  createdAt             DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                 @default(now()) @db.Timestamp(6)
  institution           institutions             @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "degree_theses_institutionId_fkey")
  submitted_by          users                    @relation("DegreeThesisSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "degree_theses_submittedBy_fkey")
  review_case           content_review_cases     @relation(fields: [reviewCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "degree_theses_reviewCaseId_fkey")
  versions              degree_thesis_versions[] @relation("DegreeThesisVersions")
  current_version       degree_thesis_versions?  @relation("DegreeThesisCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "degree_theses_currentVersionId_fkey")
  published_version     degree_thesis_versions?  @relation("DegreeThesisPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "degree_theses_publishedVersionId_fkey")

  @@unique([institutionId, institution_reference], map: "degree_theses_inst_reference_idx")
  @@index([institutionId, publishedAt], map: "degree_theses_inst_published_idx")
  @@index([submittedBy, updatedAt], map: "degree_theses_submitter_updated_idx")
}

model degree_thesis_versions {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thesisId              String         @db.Uuid
  version_number        Int
  title                 String         @db.VarChar(500)
  title_en              String?        @db.VarChar(500)
  author_name           String         @db.VarChar(100)
  student_id            String?        @db.VarChar(100)
  training_unit         String         @db.VarChar(200)
  major                 String         @db.VarChar(200)
  degree_category       String         @db.VarChar(64)
  award_year            Int            @db.SmallInt
  advisors              String[]       @default([]) @db.VarChar(100)
  abstract              String?        @db.VarChar
  keywords              String[]       @default([]) @db.VarChar(100)
  language              String         @default("zh-CN") @db.VarChar(16)
  visibility            String         @default("public") @db.VarChar(32)
  confidentiality_until DateTime?      @db.Date
  fileId                String?        @db.Uuid
  createdBy             String         @db.Uuid
  createdAt             DateTime       @default(now()) @db.Timestamp(6)
  submittedAt           DateTime?      @db.Timestamp(6)
  thesis                degree_theses  @relation("DegreeThesisVersions", fields: [thesisId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "degree_thesis_versions_thesisId_fkey")
  file                  oss_files?     @relation(fields: [fileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "degree_thesis_versions_fileId_fkey")
  created_by            users          @relation("DegreeThesisVersionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "degree_thesis_versions_createdBy_fkey")
  current_for           degree_theses? @relation("DegreeThesisCurrentVersion")
  published_for         degree_theses? @relation("DegreeThesisPublishedVersion")

  @@unique([thesisId, version_number], map: "degree_thesis_versions_thesis_version_idx")
  @@index([training_unit, award_year], map: "degree_thesis_versions_unit_year_idx")
  @@index([degree_category, award_year], map: "degree_thesis_versions_degree_year_idx")
  @@index([major], map: "degree_thesis_versions_major_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "degree_thesis_versions_title_trgm_idx", type: Gin)
  @@index([author_name(ops: raw("gin_trgm_ops"))], map: "degree_thesis_versions_author_trgm_idx", type: Gin)
  @@index([fileId])
}

model paper_submissions {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paperId            String         @db.Uuid
  claimId            String?        @db.Uuid
  userId             String         @db.Uuid
  institutionId      String?        @db.Uuid
  labId              String?        @db.Uuid
  oss_file_id        String?        @db.Uuid
  metadata_snapshot  Json?
  notes              String?        @db.VarChar
  createdAt          DateTime       @default(now()) @db.Timestamp(6)
  updatedAt          DateTime       @default(now()) @db.Timestamp(6)
  paper              papers         @relation(fields: [paperId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "paper_submissions_paperId_fkey")
  claim              paper_claims?  @relation("PaperSubmissionClaim", fields: [claimId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "paper_submissions_claimId_fkey")
  primary_for_claims paper_claims[] @relation("PaperClaimPrimarySubmission")
  user               users          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "paper_submissions_userId_fkey")
  institution        institutions?  @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "paper_submissions_institutionId_fkey")
  lab                labs?          @relation(fields: [labId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "paper_submissions_labId_fkey")
  oss_file           oss_files?     @relation(fields: [oss_file_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "paper_submissions_oss_file_id_fkey")

  @@index([paperId])
  @@index([claimId])
  @@index([userId])
  @@index([institutionId])
  @@index([labId])
  @@index([oss_file_id])
}

model forum_posts {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paperId       String           @db.Uuid
  userId        String           @db.Uuid
  title         String           @db.VarChar(200)
  content       String           @db.VarChar
  like_count    Int              @default(0)
  comment_count Int              @default(0)
  createdAt     DateTime         @db.Timestamp(6)
  updatedAt     DateTime         @db.Timestamp(6)
  paper         papers           @relation(fields: [paperId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_posts_paperId_fkey")
  user          users            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_posts_userId_fkey")
  comments      forum_comments[]
  likes         forum_likes[]

  @@index([paperId])
  @@index([userId])
}

model forum_comments {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId          String           @db.Uuid
  userId          String           @db.Uuid
  content         String           @db.VarChar
  parentCommentId String?          @db.Uuid
  createdAt       DateTime         @db.Timestamp(6)
  post            forum_posts      @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_comments_postId_fkey")
  user            users            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_comments_userId_fkey")
  parent          forum_comments?  @relation("ForumCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_comments_parentCommentId_fkey")
  replies         forum_comments[] @relation("ForumCommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
}

model forum_likes {
  id        Int         @id @default(autoincrement())
  postId    String      @db.Uuid
  userId    String      @db.Uuid
  createdAt DateTime    @db.Timestamp(6)
  post      forum_posts @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_likes_postId_fkey")
  user      users       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forum_likes_userId_fkey")

  @@unique([postId, userId])
  @@index([userId])
}

model scholar_embeddings {
  id            BigInt                 @id @default(autoincrement())
  doi           String                 @db.VarChar(200)
  scholar_ids   String[]               @default([]) @db.Uuid
  scholar_names String[]               @default([]) @db.VarChar
  title         String?
  abstract      String?
  embedding     Unsupported("vector")?
  createdAt     DateTime               @default(now()) @db.Timestamp(6)

  @@index([doi], map: "scholar_embeddings_doi_idx")
  @@index([embedding], map: "scholar_embeddings_vector_idx")
}

model scholar_source_papers {
  doi             String   @id @db.VarChar(200)
  title           String   @default("") @db.VarChar(500)
  abstract        String?
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  pdf_source_path String?
  updatedAt       DateTime @default(now()) @db.Timestamp(6)
}

model scholar_source_profiles {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(200)
  doi_list  String[] @default([]) @db.VarChar
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  academy   String[] @default([]) @db.VarChar
}

model scholar_research_periods {
  id                      BigInt                                @id @default(autoincrement())
  generation_id           String                                @db.Uuid
  scholar_id              String                                @db.Uuid
  period_start_year       Int
  period_end_year         Int
  paper_count             Int
  papers_with_abstract    Int
  papers_without_abstract Int
  focus_summary           String
  focus_tags              String[]                              @default([]) @db.VarChar
  createdAt               DateTime                              @default(now()) @db.Timestamp(6)
  generation              scholar_research_timeline_generations @relation(fields: [generation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_research_periods_generation_id_fkey")
  scholar                 scholars                              @relation(fields: [scholar_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_research_periods_scholar_id_fkey")
  source_papers           scholar_research_period_papers[]

  @@unique([generation_id, period_start_year, period_end_year], map: "scholar_research_periods_generation_period_key")
  @@index([scholar_id, period_start_year], map: "scholar_research_periods_scholar_period_idx")
  @@index([generation_id], map: "scholar_research_periods_generation_idx")
  @@index([focus_tags], map: "scholar_research_periods_tags_gin_idx", type: Gin)
}

model scholar_research_timeline_generations {
  id                     String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholar_id             String                                  @db.Uuid
  source_type            String                                  @db.VarChar(32)
  status                 String                                  @default("requested") @db.VarChar(32)
  requested_by           String?                                 @db.Uuid
  reviewed_by            String?                                 @db.Uuid
  reused_from_id         String?                                 @db.Uuid
  idempotency_key        String?                                 @db.VarChar(128)
  source_fingerprint     String?                                 @db.VarChar(64)
  timeline_policy        String                                  @default("fixed_calendar_windows") @db.VarChar(32)
  window_size_years      Int                                     @default(5) @db.SmallInt
  model                  String                                  @db.VarChar(100)
  prompt_version         String                                  @db.VarChar(32)
  source_paper_count     Int                                     @default(0)
  resolved_paper_count   Int                                     @default(0)
  unresolved_paper_count Int                                     @default(0)
  progress_stage         String                                  @default("requested") @db.VarChar(32)
  completed_periods      Int                                     @default(0)
  total_periods          Int                                     @default(0)
  input_tokens           Int?
  output_tokens          Int?
  attempt_count          Int                                     @default(0) @db.SmallInt
  lease_owner            String?                                 @db.VarChar(100)
  lease_expires_at       DateTime?                               @db.Timestamp(6)
  error_code             String?                                 @db.VarChar(64)
  error_message          String?
  review_notes           String?
  request_ip             String?                                 @db.VarChar(128)
  user_agent             String?                                 @db.VarChar(1000)
  requested_at           DateTime                                @default(now()) @db.Timestamp(6)
  started_at             DateTime?                               @db.Timestamp(6)
  completed_at           DateTime?                               @db.Timestamp(6)
  reviewed_at            DateTime?                               @db.Timestamp(6)
  published_at           DateTime?                               @db.Timestamp(6)
  createdAt              DateTime                                @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                                @default(now()) @db.Timestamp(6)
  scholar                scholars                                @relation(fields: [scholar_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_timeline_generations_scholar_id_fkey")
  requestedBy            users?                                  @relation("TimelineGenerationRequestedBy", fields: [requested_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "scholar_timeline_generations_requested_by_fkey")
  reviewedBy             users?                                  @relation("TimelineGenerationReviewedBy", fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "scholar_timeline_generations_reviewed_by_fkey")
  reusedFrom             scholar_research_timeline_generations?  @relation("TimelineGenerationReuse", fields: [reused_from_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "scholar_timeline_generations_reused_from_id_fkey")
  reusedBy               scholar_research_timeline_generations[] @relation("TimelineGenerationReuse")
  periods                scholar_research_periods[]
  requests               scholar_research_timeline_requests[]
  issues                 scholar_research_timeline_issues[]

  @@unique([scholar_id], map: "scholar_timeline_one_published_idx", where: raw("((status)::text = 'published'::text)"))
  @@unique([scholar_id], map: "scholar_timeline_one_active_job_idx", where: raw("((status)::text = ANY (ARRAY[('queued'::character varying)::text, ('running'::character varying)::text]))"))
  @@unique([requested_by, idempotency_key], map: "scholar_timeline_request_idempotency_idx", where: raw("((requested_by IS NOT NULL) AND (idempotency_key IS NOT NULL))"))
  @@index([status, requested_at], map: "scholar_timeline_generations_status_requested_idx")
  @@index([scholar_id, createdAt], map: "scholar_timeline_generations_scholar_created_idx")
  @@index([requested_by, createdAt], map: "scholar_timeline_generations_requester_created_idx")
  @@index([source_fingerprint, model, prompt_version], map: "scholar_timeline_generations_fingerprint_idx")
}

model scholar_research_period_papers {
  id             BigInt                   @id @default(autoincrement())
  period_id      BigInt
  paper_id       String?                  @db.Uuid
  year           Int
  title_snapshot String
  doi_snapshot   String
  has_abstract   Boolean                  @default(false)
  source_status  String                   @db.VarChar(32)
  display_order  Int
  period         scholar_research_periods @relation(fields: [period_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_research_period_papers_period_id_fkey")
  paper          papers?                  @relation(fields: [paper_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "scholar_research_period_papers_paper_id_fkey")

  @@unique([period_id, display_order], map: "scholar_research_period_papers_period_order_key")
  @@index([period_id], map: "scholar_research_period_papers_period_idx")
  @@index([paper_id], map: "scholar_research_period_papers_paper_idx")
}

model scholar_research_timeline_requests {
  id              String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generation_id   String                                @db.Uuid
  user_id         String                                @db.Uuid
  idempotency_key String                                @db.VarChar(128)
  createdAt       DateTime                              @default(now()) @db.Timestamp(6)
  generation      scholar_research_timeline_generations @relation(fields: [generation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_timeline_requests_generation_id_fkey")
  user            users                                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_timeline_requests_user_id_fkey")

  @@unique([user_id, idempotency_key], map: "scholar_timeline_requests_user_idempotency_key")
  @@index([generation_id], map: "scholar_timeline_requests_generation_idx")
  @@index([generation_id, user_id], map: "scholar_timeline_requests_generation_user_idx")
}

model scholar_research_timeline_issues {
  id              BigInt                                @id @default(autoincrement())
  generation_id   String                                @db.Uuid
  paper_id        String?                               @db.Uuid
  doi             String                                @default("") @db.VarChar(200)
  issue_type      String                                @db.VarChar(32)
  existing_year   Int?
  candidate_year  Int?
  metadata_source String?                               @db.VarChar(32)
  message         String
  createdAt       DateTime                              @default(now()) @db.Timestamp(6)
  generation      scholar_research_timeline_generations @relation(fields: [generation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scholar_timeline_issues_generation_id_fkey")
  paper           papers?                               @relation(fields: [paper_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "scholar_timeline_issues_paper_id_fkey")

  @@index([generation_id, id], map: "scholar_timeline_issues_generation_idx")
  @@index([paper_id], map: "scholar_timeline_issues_paper_idx")
}

{
  "name": "@airalogy/scholar-server",
  "version": "3.0.0",
  "private": true,
  "description": "Airalogy Scholar server",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "prisma/migrations",
    "prisma/schema.prisma",
    "prisma.config.ts",
    "README.md"
  ],
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env --watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && tsc-alias -p tsconfig.json -f -fe .js && node ../../scripts/write-build-info.mjs dist/build-info.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "smoke:dist": "node dist/src/scripts/smoke-built-app.js",
    "bootstrap:deployment": "tsx --env-file-if-exists=.env src/scripts/bootstrap-deployment.ts",
    "lint": "oxlint --ignore-path=.gitignore",
    "lint:fix": "oxlint --fix --ignore-path=.gitignore",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "sync:scholars": "tsx --env-file-if-exists=.env src/scripts/sync-scholar-data.ts",
    "import:scholar-timeline": "tsx --env-file-if-exists=.env src/scripts/import-scholar-research-timeline.ts",
    "enqueue:scholar-timelines": "tsx --env-file-if-exists=.env src/scripts/enqueue-scholar-research-timelines.ts",
    "embeddings:papers": "tsx --env-file-if-exists=.env src/scripts/generate-paper-embeddings.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:validate": "prisma format --check && prisma validate",
    "db:audit:integrity": "tsx --env-file-if-exists=.env src/scripts/audit-data-integrity.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.7.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "fastify-tsconfig": "^3.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}

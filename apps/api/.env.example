# Runtime
NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=
HOST=0.0.0.0
PORT=3000

# Deployment
DEPLOYMENT_MODE=public
PRIVATE_INSTITUTION_SLUG=
PUBLIC_APP_NAME='Airalogy Scholar'
SHOW_BRAND_LOGO=true
SHOW_INSTITUTION_LOGO=false
# Optional HTTP(S) or application-relative asset URLs. Institution assets are deployment data
# and are intentionally not bundled in the source repository.
PUBLIC_BRAND_LOGO_URL=
PUBLIC_INSTITUTION_LOGO_URL=
PUBLIC_INSTITUTION_WATERMARK_URL=

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ENABLE_PASSWORD_SIGNIN=true
ENABLE_PUBLIC_SIGNUP=false
ENABLE_AIRALOGY_OAUTH=false
ENABLE_INSTITUTION_LOGIN=false
INSTITUTION_LOGIN_INSTITUTION_SLUG=
ENABLE_INSTITUTION_PROVISION_LOGIN=false
INSTITUTION_SSO_ENABLED=false

# Features
ENABLE_AI_CHAT=false
SCHOLAR_TIMELINE_GENERATION_MODE=disabled
TIMELINE_CONCURRENCY=2
TIMELINE_DAILY_USER_LIMIT=3
ENABLE_PAPER_UPLOAD=true
ENABLE_DEGREE_THESES=true
ENABLE_FORUM=true

# PostgreSQL
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/airalogy_scholar?schema=public'
# Required only by the local source-table synchronization command.
SCHOLAR_IMPORT_INSTITUTION_NAME=
# Seed deletes existing application data. Enable only for a disposable database.
ALLOW_DESTRUCTIVE_SEED=false

# Storage: local is the zero-configuration development default
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=data/uploads
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# OpenAI-compatible model service (required for AI chat or timeline generation)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-v4
CHAT_MODEL=qwen3.5-plus
# Empty uses CHAT_MODEL.
TIMELINE_MODEL=
OPENALEX_MAILTO=

# Airalogy OAuth (required when ENABLE_AIRALOGY_OAUTH=true)
AIRALOGY_OAUTH_BASE_URL=
AIRALOGY_OAUTH_CLIENT_ID=
AIRALOGY_OAUTH_CLIENT_SECRET=
AIRALOGY_OAUTH_REDIRECT_URI=
AIRALOGY_OAUTH_SCOPE=basic

# Institution SSO (required when INSTITUTION_SSO_ENABLED=true)
INSTITUTION_SSO_TYPE=oauth2
INSTITUTION_SSO_PROVIDER_ID=institution-sso
INSTITUTION_SSO_DISPLAY_NAME='Institution Single Sign-On'
INSTITUTION_SSO_AUTHORIZATION_URL=
INSTITUTION_SSO_TOKEN_URL=
INSTITUTION_SSO_USERINFO_URL=
INSTITUTION_SSO_CLIENT_ID=
INSTITUTION_SSO_CLIENT_SECRET=
INSTITUTION_SSO_REDIRECT_URI=http://localhost:5173/institution_sso_callback
INSTITUTION_SSO_SCOPE=basic
INSTITUTION_SSO_EXTERNAL_ID_FIELD=sub
INSTITUTION_SSO_EMAIL_FIELD=email
INSTITUTION_SSO_NAME_FIELD=name
INSTITUTION_SSO_USERINFO_TOKEN_MODE=bearer

# Build identity (normally injected by CI/CD)
APP_VERSION=3.0.0
GIT_COMMIT=
GIT_TAG=
BUILD_TIME=
BUILD_DIRTY=false
